// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/dotnet
{
	"name": "C# (.NET)",
	"image": "mcr.microsoft.com/devcontainers/dotnet:2-10.0-noble",
	"containerEnv": {
		"WrathInstallDir": "/home/Wrath"
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-dotnettools.csharp",
				"ms-dotnettools.csdevkit"
			]
		}
	},
	"mounts": [
		"source=${localEnv:WrathPath},target=/home/Wrath,type=bind,readonly",
		"source=${localEnv:WrathPath}/Mods,target=/home/Wrath/Mods,type=bind"
	]
}
